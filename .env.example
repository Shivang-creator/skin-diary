# Skin Diary — environment
#
# Copy to .env.local and fill in. .env.local is gitignored and must never
# be committed.

# YouCam API key from https://yce.perfectcorp.com/api-console/en/api-keys/
# Server-side only. It is never exposed to the browser: every call goes
# through /api/analyze and /api/units.
#
# Leave this BLANK to run entirely in fixture mode — the app is fully
# usable without a key, and spends no units.
YOUCAM_API_KEY=

# Force fixture mode even when a key is present. Useful for demos and for
# not burning units during development.
#   YOUCAM_MODE=fixture
YOUCAM_MODE=
